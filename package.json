{
    "name": "q-template-validator",
    "version": "9.0.0",
    "description": "Ensure questionnaire templates are valid",
    "main": "index.js",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "test": "node --test",
        "test:watch": "node --test --watch",
