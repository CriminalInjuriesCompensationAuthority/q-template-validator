        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10"
    },
    "dependencies": {
        "ajv": "^6.12.0",
        "ajv-errors": "^1.0.1"
